# Development configuration with PostgreSQL
# Replace with your actual PostgreSQL connection details
DATABASE_URL="postgresql://postgres:password@localhost:5432/openproduct_dev"
SVELTEKIT_PORT=3000
PUBLIC_BASE_PATH=""

# Email (optional for development)
FROM_EMAIL='OpenProduct <noreply@openproduct.local>'

# SMTP (optional for development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI (dev):      http://localhost:5173/auth/oauth/google/callback
# Authorized redirect URI (prod):     https://openproduct.fr/new/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth (https://developers.facebook.com/apps)
# Authorized redirect URI (dev):      http://localhost:5173/auth/oauth/facebook/callback
# Authorized redirect URI (prod):     https://openproduct.fr/new/auth/oauth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Microsoft OAuth (https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps)
# Authorized redirect URI (dev):      http://localhost:5173/auth/oauth/microsoft/callback
# Authorized redirect URI (prod):     https://openproduct.fr/new/auth/oauth/microsoft/callback
MICROSOFT_TENANT_ID="common"
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Logging (optional for development)
AXIOM_TOKEN=
AXIOM_ORG_ID=
AXIOM_DATASET=
